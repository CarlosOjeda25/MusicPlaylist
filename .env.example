# --- SEGURIDAD Y CIFRADO (Obligatorios en producción) ---
# Clave de 32 caracteres (o 64 hex) para cifrar los tokens OAuth con AES-256-GCM
ENCRYPTION_KEY="cambiar_por_32_caracteres_exactos!"

# Clave secreta para firmar cookies de sesión y tokens anti-CSRF (mínimo 32 caracteres)
SESSION_SECRET="cambiar_por_clave_secreta_de_al_menos_32_chars!"

# URL pública de tu aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- BASE DE DATOS (Opcional si usas Cloudflare D1 o desarrollo local) ---
# Si usas Cloudflare D1, se configura en wrangler.json (binding DB).
# Si usas PostgreSQL (Neon / Supabase / Docker), descomenta y pega la URL:
# DATABASE_URL="postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require"


# --- SPOTIFY OAUTH (Para conectar playlists de Spotify) ---
# Consola: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="tu_spotify_client_id"
SPOTIFY_CLIENT_SECRET="tu_spotify_client_secret"
# En producción cambiar localhost por tu dominio (ej: https://tu-app.pages.dev/api/auth/spotify/callback)
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/auth/spotify/callback"


# --- GOOGLE / YOUTUBE OAUTH (Para conectar playlists de YouTube Music) ---
# Consola: https://console.cloud.google.com/apis/credentials
# Debes habilitar "YouTube Data API v3" en la biblioteca de APIs de Google Cloud
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
# En producción cambiar localhost por tu dominio (ej: https://tu-app.pages.dev/api/auth/google/callback)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"


# --- IA / GEMINI (Opcional - Ahora tenemos modo BYOK en la interfaz) ---
# Si la configuras, sirve como cuota global del servidor.
# Si la dejas vacía, los usuarios ingresan su propia clave en la UI o se usa el filtro heurístico local.
GEMINI_API_KEY=""
