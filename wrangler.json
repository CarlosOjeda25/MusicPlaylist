{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musicplaylist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://musicplaylist.cdoprojects.workers.dev",
    "SPOTIFY_REDIRECT_URI": "https://musicplaylist.cdoprojects.workers.dev/api/auth/spotify/callback",
    "GOOGLE_REDIRECT_URI": "https://musicplaylist.cdoprojects.workers.dev/api/auth/google/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-playlist-radar-d1",
      "database_id": "00b3327b-1322-4a81-9f76-e3e59dbdf6db"
    }
  ]
}
